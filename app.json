{
  "expo": {
    "name": "Onyak",
    "slug": "Onyak",
    "scheme": "onyak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/onyak-app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/onyak-android-foreground.png",
        "backgroundImage": "./assets/onyak-android-background.png",
        "monochromeImage": "./assets/onyak-android-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/onyak-web-favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
